---
import { profile, work } from '../data/profile';
import publications from '../data/publications.bib?raw';
import { parseBibtex, formatCitations } from '../lib/bibtex';
import Icon from '../components/Icon.astro';
import WorkArt from '../components/WorkArt.astro';
import '../styles/global.css';
const papers = parseBibtex(publications);
const schema = { '@context': 'https://schema.org', '@type': 'ProfilePage', name: 'Di Yang — Academic Homepage', url: profile.url, mainEntity: { '@type': 'Person', name: profile.name, affiliation: { '@type': 'CollegeOrUniversity', name: profile.institution }, sameAs: [profile.scholar, profile.github], knowsAbout: profile.interests } };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Di Yang — AI, Code & Curiosity</title>
    <meta name="description" content="Di Yang at East China Normal University. Research in code generation, AI for software engineering, agents, deepfake detection, and trustworthy AI."/>
    <meta name="theme-color" content="#f7f8fc"/>
    <link rel="canonical" href={profile.url + '/'}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin/>
    <meta property="og:title" content="Di Yang — AI, Code & Curiosity"/><meta property="og:description" content="Exploring the space between intelligent systems and reliable software."/>
    <meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/><meta property="og:type" content="profile"/><meta property="og:url" content={profile.url + '/'}/><meta property="og:image" content={profile.url + '/social.png'}/>
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}/>
    <script is:inline>try{const t=localStorage.getItem('di-theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t;}catch{}</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href="#home" aria-label="Di Yang home"><span class="brand-mark" aria-hidden="true">d<span>y</span><i></i></span><span class="brand-description">DI YANG<br/><small>AI & SOFTWARE</small></span></a>
        <nav aria-label="Main navigation"><a href="#about" data-en="About" data-zh="关于">About</a><a href="#research" data-en="Research" data-zh="研究">Research</a><a href="#publications" data-en="Publications" data-zh="论文">Publications</a></nav>
        <div class="header-tools"><button class="lang-button" id="language-toggle" aria-label="Switch to Chinese">中</button><button class="theme-button" id="theme-toggle" aria-label="Toggle dark mode"><span class="sun-icon"><Icon name="sun"/></span><span class="moon-icon"><Icon name="moon"/></span></button><a class="header-contact" href="#connect"><span data-en="Let's connect" data-zh="与我联系">Let's connect</span><Icon name="external" size={17}/></a></div>
      </header>
      <main id="main">
        <section class="hero" id="home" aria-labelledby="hero-title">
          <div class="hero-eyebrow"><span class="eyebrow"><i class="small-star" aria-hidden="true">✳</i><span data-en="A LITTLE CURIOSITY. A LOT OF POSSIBILITY." data-zh="保持好奇，探索更多可能。">A LITTLE CURIOSITY. A LOT OF POSSIBILITY.</span></span><span class="edition">PERSONAL RESEARCH SPACE / 2026</span></div>
          <div class="hero-main">
            <div class="hero-copy"><p class="intro" data-en="Hello, I'm" data-zh="你好，我是">Hello, I'm</p><h1 id="hero-title">Di Yang<span>.</span></h1><h2><span data-en="Exploring AI." data-zh="探索智能。">Exploring AI.</span><br/><span class="blue-text" data-en="Building trust." data-zh="构建可信。">Building trust.</span></h2><p class="hero-description" data-pretext data-en="I explore the space between intelligent systems and reliable software. Currently interested in code generation, AI for software engineering, and agents." data-zh="探索智能系统与可靠软件之间的可能。关注代码生成、面向软件工程的人工智能与智能体。">I explore the space between intelligent systems and reliable software. Currently interested in code generation, AI for software engineering, and agents.</p><div class="hero-actions"><a class="button button-blue" href="#research"><span data-en="Explore my work" data-zh="探索我的研究">Explore my work</span><Icon name="down" size={18}/></a><a class="text-link" href={profile.scholar} target="_blank" rel="noopener noreferrer">Google Scholar<Icon name="external" size={17}/></a></div></div>
            <div class="hero-visual"><div class="visual-heading"><span class="visual-dot"></span><span>INTELLIGENCE, IN MOTION</span><button id="motion-toggle" aria-label="Pause animation" aria-pressed="false">Ⅱ</button></div><canvas id="research-canvas" aria-hidden="true"></canvas><div class="visual-center" aria-hidden="true">{`{ }`}</div><div class="floating-label label-code"><span>01</span> code generation<Icon name="external" size={13}/></div><div class="floating-label label-agent"><span>02</span> intelligent agents</div><div class="visual-footer"><span>A SPACE FOR IDEAS<br/><b>TO TAKE SHAPE.</b></span><span class="orbit-star" aria-hidden="true">✳</span></div></div>
          </div>
          <div class="hero-bottom"><a class="affiliation" href="https://www.ecnu.edu.cn/" target="_blank" rel="noopener noreferrer"><span class="institution-mark" aria-hidden="true">E</span><span><small data-en="AFFILIATION" data-zh="所在单位">AFFILIATION</small><strong data-en={profile.institution} data-zh={profile.institutionZh}>{profile.institution}</strong></span><Icon name="external" size={16}/></a><div class="interest-tags"><span>Code Generation</span><span>AI for SE</span><span>Agents</span></div><a href="#about" class="scroll-link" aria-label="Scroll to about"><Icon name="down"/></a></div>
        </section>
        <section class="about section" id="about" aria-labelledby="about-title"><div class="section-label"><span class="section-number">01 /</span><span data-en="THE BIG PICTURE" data-zh="关于我的研究">THE BIG PICTURE</span></div><div class="about-main"><h2 id="about-title"><span data-en="Better questions." data-zh="提出更好的问题。">Better questions.</span><br/><span class="muted" data-en="More reliable answers." data-zh="寻找更可靠的答案。">More reliable answers.</span></h2><p data-en={profile.bio} data-zh={profile.bioZh}>{profile.bio}</p><a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={18}/><span data-en="Find me on GitHub" data-zh="在 GitHub 上找到我">Find me on GitHub</span><Icon name="external" size={16}/></a></div><aside class="scholar-snapshot" aria-label="Google Scholar statistics"><div class="snapshot-title"><Icon name="scholar" size={19}/><span>SCHOLAR SNAPSHOT</span></div><div class="metrics"><div><strong>03</strong><span data-en="Publications" data-zh="论文">Publications</span></div><div><strong>{profile.metrics.citations}</strong><span data-en="Citations" data-zh="引用">Citations</span></div><div><strong>{profile.metrics.hIndex}</strong><span>h-index</span></div></div><a href={profile.scholar} target="_blank" rel="noopener noreferrer"><span data-en="As of Sep 16, 2026" data-zh="数据截至 2026 年 9 月 16 日">As of Sep 16, 2026</span><Icon name="external" size={15}/></a></aside></section>
        <section class="section research-section" id="research" aria-labelledby="research-title"><div class="section-top"><div><div class="section-label"><span class="section-number">02 /</span><span data-en="IDEAS INTO RESEARCH" data-zh="让想法成为研究">IDEAS INTO RESEARCH</span></div><h2 class="section-title" id="research-title" data-en="A few things I've been exploring." data-zh="最近在探索的事。">A few things I've been exploring.</h2></div><span class="handwritten" aria-hidden="true">curiosity → discovery</span></div><div class="work-grid">{work.map((item,index)=><article class:list={['work-card',`work-${item.slug}`]}><a class="art-link" href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`Read the ${item.title} paper`}><WorkArt kind={item.slug}/><span class="card-arrow"><Icon name="external" size={24}/></span></a><div class="work-info"><div class="work-meta"><span>{item.label}</span><span>{item.venue}</span></div><h3>{item.title}<span data-en={item.subtitle} data-zh={item.subtitleZh}>{item.subtitle}</span></h3><p data-en={item.summary} data-zh={item.summaryZh}>{item.summary}</p><a href={item.url} target="_blank" rel="noopener noreferrer" class="text-link"><span data-en="Read the paper" data-zh="阅读论文">Read the paper</span><Icon name="external" size={16}/></a></div></article>)}</div></section>
        <section class="section publication-section" id="publications" aria-labelledby="publications-title"><div class="section-top"><div><div class="section-label"><span class="section-number">03 /</span><span data-en="THE RESEARCH, IN DETAIL" data-zh="研究成果">THE RESEARCH, IN DETAIL</span></div><h2 class="section-title" id="publications-title"><span data-en="Publications" data-zh="学术论文">Publications</span><sup>03</sup></h2></div><a class="text-link" href="/publications.bib" download><span data-en="Download BibTeX" data-zh="下载 BibTeX">Download BibTeX</span><Icon name="down" size={17}/></a></div><div class="publication-toolbar"><div class="filters" role="group" aria-label="Filter publications"><button class="active" data-filter="all" aria-pressed="true" data-en="All work" data-zh="全部">All work</button><button data-filter="code" aria-pressed="false" data-en="Code generation" data-zh="代码生成">Code generation</button><button data-filter="vision" aria-pressed="false" data-en="Vision & robustness" data-zh="视觉与鲁棒性">Vision & robustness</button></div><span id="result-count" aria-live="polite">3 papers</span></div><ol class="publication-list">{work.map((item,index)=>{const paper=papers.find(p=>p.id===item.id)!;return <li data-category={item.category}><article class="publication"><div class="publication-year"><span>{item.year}</span><small>{String(index+1).padStart(2,'0')}</small></div><div class="publication-content"><div class="paper-status"><span class:list={{conference: item.slug==='ibcd'}} data-en={item.slug==='ibcd'?'Conference paper':'Preprint'} data-zh={item.slug==='ibcd'?'会议论文':'预印本'}>{item.slug==='ibcd'?'Conference paper':'Preprint'}</span><span>{item.slug==='ibcd'?'ICASSP 2024':'arXiv'}</span></div><h3><a href={item.url} target="_blank" rel="noopener noreferrer">{paper.title}</a></h3><p class="authors">{paper.authors.map((author,i)=><>{author==='Di Yang'?<strong>{author}</strong>:author}{i<paper.authors.length-1?', ':''}</>)}</p><div class="paper-actions"><a href={item.pdf} target="_blank" rel="noopener noreferrer">PDF<Icon name="external" size={14}/></a><a href={`https://doi.org/${paper.doi}`} target="_blank" rel="noopener noreferrer">DOI<Icon name="external" size={14}/></a><button data-cite={JSON.stringify(formatCitations(paper))} data-title={paper.title} aria-haspopup="dialog" aria-controls="citation-dialog"><Icon name="copy" size={14}/><span data-en="Cite" data-zh="引用">Cite</span></button><details><summary data-en="Overview +" data-zh="研究概述 +">Overview +</summary><p data-en={item.detail} data-zh={item.detailZh}>{item.detail}</p></details></div></div></article></li>})}</ol></section>
        <section class="connect" id="connect" aria-labelledby="connect-title"><div><div class="section-label"><span class="section-number">04 /</span><span data-en="KEEP THE CONVERSATION GOING" data-zh="让交流继续">KEEP THE CONVERSATION GOING</span></div><h2 id="connect-title"><span data-en="Good research starts" data-zh="好的研究，">Good research starts</span><br/><span data-en="with a conversation." data-zh="始于一次交流。">with a conversation.</span></h2><p data-en="Explore the papers, follow the code, or get in touch on GitHub." data-zh="阅读论文、关注代码，或通过 GitHub 与我交流。">Explore the papers, follow the code, or get in touch on GitHub.</p><div class="connect-links"><a class="button button-white" href={profile.github} target="_blank" rel="noopener noreferrer"><Icon name="github"/>GitHub<Icon name="external" size={17}/></a><a class="connect-scholar" href={profile.scholar} target="_blank" rel="noopener noreferrer">Google Scholar<Icon name="external" size={18}/></a></div></div><span class="connect-asterisk" aria-hidden="true">✳</span></section>
      </main>
      <footer><a class="footer-brand" href="#home">Di Yang<span>.</span></a><span data-en="Curiosity is a work in progress." data-zh="好奇心，未完待续。">Curiosity is a work in progress.</span><a href="#home"><span data-en="Back to top" data-zh="返回顶部">Back to top</span><Icon name="external" size={15}/></a><small>© 2026 Di Yang · <a href="https://github.com/jxpeng98/astro-theme-scholars" target="_blank" rel="noopener noreferrer">Scholar Pages</a></small></footer>
    </div>
    <dialog id="citation-dialog" aria-labelledby="citation-heading"><form method="dialog"><button class="dialog-close" aria-label="Close citation"><Icon name="close"/></button></form><span class="eyebrow">SHARE THE RESEARCH</span><h2 id="citation-heading" data-en="Cite this paper" data-zh="引用这篇论文">Cite this paper</h2><p id="citation-paper-title"></p><div class="citation-styles" role="group" aria-label="Citation format"><button data-style="bibtex" aria-pressed="true">BibTeX</button><button data-style="apa" aria-pressed="false">APA 7</button><button data-style="chicago" aria-pressed="false">Chicago</button></div><pre tabindex="0"><code id="citation-output"></code></pre><div class="dialog-footer"><span id="copy-status" role="status"></span><button id="copy-citation" class="button button-blue"><Icon name="copy" size={17}/><span data-en="Copy citation" data-zh="复制引用">Copy citation</span></button></div></dialog>
    <script>import '../scripts/site'; import '../scripts/scene';</script>
  </body>
</html>
