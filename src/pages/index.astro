---
import { profile, work } from '../data/profile';
import publications from '../data/publications.bib?raw';
import { parseBibtex, formatCitations } from '../lib/bibtex';
import Icon from '../components/Icon.astro';
import '../styles/global.css';

const papers = parseBibtex(publications);
const description = 'Di Yang, Ph.D. student at East China Normal University and jointly trained at Shanghai Innovation Institute. Research in code generation, AI for software engineering, and agents.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'Di Yang — Academic Homepage',
  url: profile.url,
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    jobTitle: 'Ph.D. Student',
    affiliation: [
      { '@type': 'CollegeOrUniversity', name: profile.institution },
      { '@type': 'EducationalOrganization', name: profile.jointInstitution },
    ],
    sameAs: [profile.scholar, profile.github],
    knowsAbout: profile.interests,
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Di Yang — Academic Homepage</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={profile.url + '/'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content="Di Yang — Academic Homepage" />
    <meta property="og:description" content={description} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={profile.url + '/'} />
    <meta property="og:image" content={profile.url + '/social.png'} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('di-theme');
        if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main" data-en="Skip to content" data-zh="跳至正文">Skip to content</a>
    <div class="page-shell" id="home">
      <header class="site-header">
        <a class="brand" href="#home">Di Yang</a>
        <nav aria-label="Main navigation">
          <a href="#about" data-en="About" data-zh="关于">About</a>
          <a href="#news" data-en="News" data-zh="动态">News</a>
          <a href="#publications" data-en="Publications" data-zh="论文">Publications</a>
        </nav>
        <div class="header-tools">
          <button id="language-toggle" aria-label="Switch to Chinese">中文</button>
          <button id="theme-toggle" class="theme-button" aria-label="Switch to dark mode">
            <span class="sun-icon"><Icon name="sun" size={17} /></span>
            <span class="moon-icon"><Icon name="moon" size={17} /></span>
          </button>
        </div>
      </header>

      <main id="main">
        <section class="profile-section" id="about" aria-labelledby="profile-title">
          <h1 id="profile-title">Di Yang <span class="greeting-emoji" aria-hidden="true">👋</span></h1>
          <p class="role" data-en="Ph.D. Student" data-zh="博士研究生">Ph.D. Student</p>
          <div class="affiliations">
            <a href="https://www.ecnu.edu.cn/" target="_blank" rel="noopener noreferrer" data-en={profile.institution} data-zh={profile.institutionZh}>{profile.institution}</a>
            <p>
              <span data-en="Jointly trained at" data-zh="联合培养于">Jointly trained at</span>
              {' '}<a href="https://www.sii.edu.cn/" target="_blank" rel="noopener noreferrer"><span data-en={profile.jointInstitution} data-zh={profile.jointInstitutionZh}>{profile.jointInstitution}</span> (SII)</a>
            </p>
          </div>
          <p class="bio" data-en={profile.bio} data-zh={profile.bioZh}>{profile.bio}</p>
          <div class="profile-links">
            <a href={profile.scholar} target="_blank" rel="noopener noreferrer">Google Scholar<Icon name="external" size={14} /></a>
            <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub<Icon name="external" size={14} /></a>
          </div>
          <div class="personal-note">
            <p data-en="Outside research, I enjoy" data-zh="科研之外，我喜欢">Outside research, I enjoy</p>
            <ul class="hobbies">
              {profile.hobbies.map(hobby => (
                <li><span class="hobby-emoji" aria-hidden="true">{hobby.emoji}</span><span data-en={hobby.en} data-zh={hobby.zh}>{hobby.en}</span></li>
              ))}
            </ul>
          </div>
        </section>

        <section class="section" id="news" aria-labelledby="news-title">
          <h2 id="news-title" data-en="News" data-zh="研究动态">News</h2>
          <div class="news-item">
            <span class="year">2026</span>
            <p>
              <span data-en="Our Orchid paper was accepted to" data-zh="Orchid 论文被">Our Orchid paper was accepted to</span>
              {' '}<strong>ASE 2026</strong><span data-en=" and received a " data-zh=" 录用，并获 "> and received a </span>
              <a href="#orchid"><span aria-hidden="true">🏅</span> Distinguished Paper Award</a><span data-en="." data-zh="。">.</span>
            </p>
          </div>
        </section>

        <section class="section publications-section" id="publications" aria-labelledby="publications-title">
          <div class="section-heading">
            <h2 id="publications-title" data-en="Selected Publication" data-zh="代表论文">Selected Publication</h2>
            <a class="bibliography-link" href="/publications.bib" download data-en="Download BibTeX" data-zh="下载 BibTeX">Download BibTeX</a>
          </div>
          <ol class="publication-list">
            {work.map(item => {
              const paper = papers.find(p => p.id === item.id);
              if (!paper) throw new Error(`Missing bibliography entry for ${item.id}`);
              return (
                <li>
                  <article class="publication" id="orchid" data-publication={item.id}>
                    <span class="year">{item.year}</span>
                    <div class="publication-content">
                      <h3><a href={item.url} target="_blank" rel="noopener noreferrer">{paper.title}</a></h3>
                      <p class="authors">
                        {paper.authors.map((author, index) => <><span class="author">{author === profile.name ? <strong>{author}</strong> : author}</span>{index < paper.authors.length - 1 ? ', ' : ''}</>)}
                      </p>
                      <p class="venue">
                        <a href={item.conference} target="_blank" rel="noopener noreferrer">{item.venue}</a>
                        <span class="venue-separator" aria-hidden="true">·</span>
                        <span data-en="Accepted" data-zh="已录用">Accepted</span>
                        <span class="award"><span aria-hidden="true">🏅</span>{item.award}</span>
                      </p>
                      <p class="paper-summary" data-en={item.summary} data-zh={item.summaryZh}>{item.summary}</p>
                      <div class="paper-links">
                        <a href={item.pdf} target="_blank" rel="noopener noreferrer">PDF</a>
                        <a href={item.manuscript} target="_blank" rel="noopener noreferrer">arXiv</a>
                        <a href={item.url} target="_blank" rel="noopener noreferrer">DOI</a>
                        <a href={item.dataset} target="_blank" rel="noopener noreferrer">Hugging Face<Icon name="external" size={13} /></a>
                        <button data-cite={JSON.stringify(formatCitations(paper))} data-title={paper.title} aria-haspopup="dialog" aria-controls="citation-dialog">BibTeX</button>
                      </div>
                    </div>
                  </article>
                </li>
              );
            })}
          </ol>
        </section>
      </main>

      <footer>
        <span>© 2026 Di Yang</span>
        <span><span data-en="Updated" data-zh="更新于">Updated</span> <time datetime={profile.updated}>2026.09</time></span>
      </footer>
    </div>

    <dialog id="citation-dialog" aria-labelledby="citation-heading">
      <form method="dialog"><button class="dialog-close" aria-label="Close citation"><Icon name="close" /></button></form>
      <h2 id="citation-heading" data-en="Cite this paper" data-zh="引用这篇论文">Cite this paper</h2>
      <p id="citation-paper-title"></p>
      <div class="citation-styles" role="group" aria-label="Citation format">
        <button data-style="bibtex" aria-pressed="true">BibTeX</button>
        <button data-style="apa" aria-pressed="false">APA 7</button>
        <button data-style="chicago" aria-pressed="false">Chicago</button>
      </div>
      <pre tabindex="0"><code id="citation-output"></code></pre>
      <div class="dialog-footer">
        <span id="copy-status" role="status"></span>
        <button id="copy-citation" class="copy-button"><Icon name="copy" size={15} /><span data-en="Copy citation" data-zh="复制引用">Copy citation</span></button>
      </div>
    </dialog>
    <script>import '../scripts/site';</script>
  </body>
</html>
