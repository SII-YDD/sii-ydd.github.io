---
const { kind } = Astro.props;
---
<div class:list={['work-art', `art-${kind}`]} aria-hidden="true">
  {kind === 'orchid' && <>
    <div class="code-note"><span class="code-dots">● ● ●</span><span class="code-comment">// one requirement</span><span>“return the <em>first</em> match”</span><span class="code-comment">// more than one interpretation</span><span class="code-line"><b>intent</b> <span>→</span> <i>?</i> <span>→</span> <b>code</b></span></div>
    <div class="task-sticker"><strong>1,304</strong><span>BENCHMARK TASKS</span></div>
    <span class="art-corner">01 / AMBIGUITY</span>
  </>}
  {kind === 'tofe' && <>
    <div class="vision-grid">{Array.from({length: 64}, (_, i) => <i style={`--i:${i};--alpha:${0.2 + ((i * 17 + 5) % 23) / 29}`}/>)}</div>
    <span class="scan-line"></span><span class="vision-label">IMAGE ↔ TEXT</span><span class="art-corner">02 / AUTHENTICITY</span>
  </>}
  {kind === 'ibcd' && <>
    <div class="defense-grid">{Array.from({length: 25}, (_, i) => <i class:list={{patch: [7,8,12,13].includes(i)}} />)}</div>
    <div class="shield"><svg viewBox="0 0 100 115" fill="none"><path d="M50 5 92 23v33c0 23-19 39-42 51C27 95 8 79 8 56V23L50 5Z" fill="currentColor"/><path d="m30 55 14 14 28-30" stroke="#fff" stroke-width="6"/></svg></div>
    <span class="art-corner">03 / ROBUSTNESS</span>
  </>}
</div>
